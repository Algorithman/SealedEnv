<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <!-- The in-memory harness PARSES the test snippets, so it needs the C# 13
         syntax (partial properties) — a newer Roslyn than the generator's own
         4.11 floor, which must stay put so older hosts can still load the
         shipped generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0"/>
    <PackageReference Include="Verify.Xunit"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio"/>
  </ItemGroup>

  <!-- Normal (non-analyzer) reference: these tests drive the generator in-memory
       via CSharpGeneratorDriver for snapshot/diagnostic testing. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SealedEnv\Generators\SealedEnvGenerator.csproj"/>
    <ProjectReference Include="..\..\src\SealedEnv\SealedEnv.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

</Project>
