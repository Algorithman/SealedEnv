<Project>

  <!-- Applies to every project in the repo (see SealedEnv-PLAN.md §2). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <VersionPrefix>1.0.2</VersionPrefix>
    <!-- Strong naming (identity, not security): the snk is committed deliberately
         (established OSS practice for analyzer/generator packages — e.g. so
         strongly-named consumer assemblies can reference the runtime lib).
         Signing is deterministic and needs no CI secret. Regenerating SealedEnv.snk
         breaks InternalsVisibleTo in Generators/InternalsVisibleTo.cs, which pins
         this key's full public blob. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)SealedEnv.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
