<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators must target netstandard2.0 to load in every Roslyn host. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SealedEnv.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (analyzer release tracking) applies from the first shipped release on; nothing has shipped yet. Wire ShippedAnalyzerApis.txt/RemovedAnalyzerApis.txt up when packaging v0.1.0-alpha (Phase 7). -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

</Project>
