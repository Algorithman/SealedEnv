<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source generators must target netstandard2.0 to load in every Roslyn host. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SealedEnv.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (analyzer release tracking) is wired via AnalyzerReleases.Shipped.md /
         AnalyzerReleases.Unshipped.md (AdditionalFiles below); no NoWarn needed. -->

  </PropertyGroup>

  <!-- Strong-named friend access for the generator unit tests. The MSBuild item
       (not a hand-written attribute) is deliberate: netstandard2.0's
       InternalsVisibleToAttribute surface has no PublicKey property (CS0246),
       while the SDK's attribute emission accepts the keyed identity.
       Regenerating SealedEnv.snk requires updating this key too. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SealedEnv.Generator.Tests" PublicKey=""/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    <!-- RS2008 release tracking (SealedEnv-PLAN.md §3 Phase 7): rules ship with
         v0.9.0.3; move the Unshipped table into Shipped on release. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>

</Project>
